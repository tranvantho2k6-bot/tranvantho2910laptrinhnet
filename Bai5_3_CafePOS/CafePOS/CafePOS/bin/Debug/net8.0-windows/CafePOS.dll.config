<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- XAMPP mặc định: user root, mật khẩu rỗng, cổng 3306. Sửa lại nếu máy bạn khác. -->
    <add name="DefaultConnection"
         connectionString="Server=localhost;Port=3306;Database=CafePOSDB;User ID=root;Password=;CharSet=utf8mb4;SslMode=None;" />
  </connectionStrings>
</configuration>
